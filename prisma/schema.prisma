// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enum: estados de una cita
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  IN_PROGRESS
  NO_SHOW
  COMPLETED
}

// Estado de sincronización con el calendario externo
enum CalendarSyncStatus {
  PENDING
  SYNCED
  FAILED
}

// NOTE: Specialty, Doctor and Patient entities are managed by the `medcore-users` microservice.
// This service (medcore-appointment) will reference users by their ObjectId (String @db.ObjectId).

// Plantilla semanal de disponibilidad de un doctor
// dayOfWeek: 0=Sunday, 1=Monday, ... 6=Saturday (coincide con JS Date#getDay())
model ScheduleTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  doctorId  String   @db.ObjectId
  dayOfWeek Int
  startTime String // formato "HH:MM", e.g. "08:00"
  endTime   String // formato "HH:MM", e.g. "17:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Excepciones para una fecha concreta (bloqueos o ventanas especiales)
model ScheduleException {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  doctorId  String   @db.ObjectId
  date      DateTime // usaremos la parte de fecha (time a 00:00) para identificar el día
  startTime String? // si null => día completo bloqueado
  endTime   String?
  isBlocked Boolean  @default(true)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Citas agendadas
model Appointment {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  patientId          String             @db.ObjectId
  doctorId           String             @db.ObjectId
  specialtyId        String?            @db.ObjectId
  reason             String?
  startAt            DateTime
  endAt              DateTime
  duration           Int                @default(30) // minutos
  status             AppointmentStatus  @default(SCHEDULED)
  // Campos para integración con Google Calendar / calendarios externos
  calendarEventId    String?
  calendarSyncStatus CalendarSyncStatus @default(PENDING)
  lastCalendarSync   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}
